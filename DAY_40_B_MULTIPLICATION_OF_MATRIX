Q80: Multiply two matrices.

/*
Sample Test Cases:
Input 1:
2 3
1 2 3
4 5 6
3 2
7 8
9 10
11 12
Output 1:
58 64
139 154

*/



#include <stdio.h>

int main() {
    int m, n, p, q;
    
    // Input dimensions of Matrix A
    printf("Enter the number of rows and columns of Matrix A: ");
    scanf("%d %d", &m, &n);
    
    int A[m][n];
    printf("Enter elements of Matrix A:\n");
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &A[i][j]);
        }
    }
    
    // Input dimensions of Matrix B
    printf("Enter the number of rows and columns of Matrix B: ");
    scanf("%d %d", &p, &q);
    
    int B[p][q];
    printf("Enter elements of Matrix B:\n");
    for (int i = 0; i < p; i++) {
        for (int j = 0; j < q; j++) {
            scanf("%d", &B[i][j]);
        }
    }
    
    // Check if multiplication is possible
    if (n != p) {
        printf("Matrix multiplication not possible.\n");
        return 0;
    }
    
    int C[m][q];  // Resultant matrix
    // Initialize result matrix
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < q; j++) {
            C[i][j] = 0;
        }
    }
    
    // Matrix multiplication logic
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < q; j++) {
            for (int k = 0; k < n; k++) {
                C[i][j] += A[i][k] * B[k][j];
            }
        }
    }
    
    // Display result
    printf("Resultant Matrix:\n");
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < q; j++) {
            printf("%d ", C[i][j]);
        }
        printf("\n");
    }
    
    return 0;
}
